#!/bin/sh

set -e

usage()
{
	echo "usage: $(basename $0) [-a] [-c kernconf] [-j jobs]" >&2
	exit 1
}

FLAGS="WITHOUT_CLEAN="
KERNCONF=$(uname -i)
JFLAG=-j$(sysctl -n hw.ncpu)
while getopts "ac:j:" opt; do
	case $opt in
	a)
		FLAGS="WITH_CLEAN="
		;;
	c)
		KERNCONF=$OPTARG
		;;
	j)
		JFLAG="-j$OPTARG"
		;;
	*)
		usage
		;;
	esac
done
shift $((OPTIND - 1))

make $JFLAG -s buildkernel $FLAGS KERNCONF=$KERNCONF
sudo -E make installkernel -s $JFLAG KERNCONF=$KERNCONF INSTKERNNAME=kernel.test DESTDIR=/
sudo nextboot -k kernel.test
sudo shutdown -r now
